# Copy this file to .env.local and fill in your values

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# App Configuration  
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Diet Support App
NEXT_PUBLIC_APP_VERSION=1.0.0

# Encryption Configuration
ENCRYPTION_ENABLED=true
ENCRYPTION_KEY=your_encryption_key_here

# Error Tracking (Optional)
# SENTRY_DSN=your_sentry_dsn_here
# SENTRY_AUTH_TOKEN=your_sentry_auth_token_here

# Analytics (Optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=your_ga_measurement_id_here

# Notion Integration Settings (Feedback Feature)
# How to create Notion Integration:
# 1. Go to https://www.notion.so/my-integrations
# 2. Click "New integration"
# 3. Set a name (e.g., "BalancePlate Feedback")
# 4. Click "Submit"
# 5. Copy the "Internal Integration Token"
NOTION_API_KEY=your_notion_api_key_here

# Notion Database ID
# How to get Database ID:
# 1. Create a new database in Notion with these properties:
#    - Title (title)
#    - Type (select: バグ報告, 機能要望, 改善提案, その他)
#    - Content (rich_text)
#    - Email (email)
#    - Status (select: 未対応, 対応中, 完了, 保留)
#    - Date (date)
#    - UserAgent (rich_text)
# 2. Get ID from the database URL
#    Example: https://notion.so/xxxxx?v=yyyy (xxxxx is the ID)
# 3. Connect the Integration to your database:
#    Click "..." in the top-right → "Add connections" → Select your integration
NOTION_DATABASE_ID=your_notion_database_id_here

# Feature Flags
NEXT_PUBLIC_ENABLE_AI_FEATURES=true
NEXT_PUBLIC_ENABLE_BACKUP=true
NEXT_PUBLIC_ENABLE_ENCRYPTION=true

# Development Settings
NODE_ENV=development